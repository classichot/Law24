# Live AI — placeholders only. Never commit real keys.
# Demo login and Nimbus / Charoen fixtures work without these.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required only when the Anthropic key is identity-linked. Console → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Optional. Examples: gpt-4o | claude-sonnet-4-6 | claude-sonnet-5
# claude-sonnet-4-20250514 is retired — LAW24 remaps it to claude-sonnet-4-6.
AI_MODEL=

# Set to 0 or false to force fixture paths even when a key is present
AI_LIVE=

# Optional. Ceiling for one structured reply; defaults to 16000.
# A bilingual X-Ray map runs 6-10k output tokens, so the Anthropic SDK default
# of 4096 truncates the JSON and the map is rejected as unreadable.
AI_MAX_OUTPUT_TOKENS=
